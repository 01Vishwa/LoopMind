# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me            # server-side only; bypasses RLS

# Postgres — transaction pooler (Supavisor :6543), used by the API at runtime
VERA_DATABASE_URL=postgresql+asyncpg://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Postgres — session mode (:5432), used by migrations, LISTEN/NOTIFY, and tests
VERA_DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

VERA_KEYVAULT_BACKEND=supabase_vault           # supabase_vault | fake

# ── Security ──────────────────────────────────────────────────────────────────
# HS256 signing secret for VERA-issued JWTs. Generate: openssl rand -hex 32
# Unused until Phase 6 (Supabase Auth JWKS verification replaces it).
VERA_JWT_SECRET=replace-me-with-32-bytes-of-hex
VERA_JWT_ACCESS_TTL_S=900
VERA_JWT_REFRESH_TTL_S=1209600

# ── Swappable backends ────────────────────────────────────────────────────────
VERA_SANDBOX_BACKEND=subprocess          # subprocess | docker | fake
VERA_SANDBOX_ALLOW_SUBPROCESS=            # set to 1 to permit the dev-only, weakly-isolated subprocess backend; unset = fail closed
VERA_STORAGE_BACKEND=local_fs            # local_fs | fake
VERA_STORAGE_ROOT=.vera/objects
VERA_EVENT_BUS_BACKEND=postgres          # postgres | memory

# ── Limits ────────────────────────────────────────────────────────────────────
VERA_MAX_UPLOAD_BYTES=104857600
VERA_SANDBOX_TIMEOUT_S=120
VERA_SANDBOX_MEMORY_MB=2048

# ── Observability ─────────────────────────────────────────────────────────────
VERA_LOG_LEVEL=info
VERA_LOG_FORMAT=json                     # json | console
VERA_OTEL_EXPORTER=console               # console | otlp | none
VERA_OTEL_ENDPOINT=
