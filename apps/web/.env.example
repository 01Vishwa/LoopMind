# Copy this file to .env.local for local development.
# Next.js loads .env.local automatically and it is gitignored.

# Base URL of the vera-api backend (apps/api). Used server-side in
# next.config.ts to proxy /api/v1/* requests during `next dev` / `next start`,
# so the browser can keep calling relative paths without CORS config.
API_URL=http://localhost:8000
